<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          On-device debugging console, reachable from adb:

            adb shell dumpsys activity provider <applicationId>/com.vynatix.holdfast.debug.HoldfastDebugProvider stores

          The provider is instantiated by the framework at process start (before
          Application.onCreate), so no app code is needed beyond registering stores
          with HoldfastDebug.register(...). It is exported so that
          `adb shell content call` can reach it too, but guarded by
          android.permission.DUMP, which only the shell and system hold; ordinary
          apps on the device cannot bind to it. Remove it from a build with
          tools:node="remove" in the app manifest if it must not ship.
        -->
        <provider
            android:name="com.vynatix.holdfast.debug.HoldfastDebugProvider"
            android:authorities="${applicationId}.holdfast-debug"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:initOrder="100" />
    </application>

</manifest>
